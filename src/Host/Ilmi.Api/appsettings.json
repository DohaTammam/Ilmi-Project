{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "UsersIdentity": {
    "Security": {
      "OtpLength": 4,
      "OtpExpirySeconds": 180,
      "OtpMaxAttempts": 5,
      "OtpLockMinutes": 10,
      "OtpMaxResends": 3,
      "LoginMaxFailures": 5,
      "LoginLockMinutes": 10,
      "MinPasswordLength": 12,
      "SelfRegistrationMinimumAge": 13,
      "PendingActivationMinutes": 10,
      "AddDependentLockMinutes": 10,
      "QuickLoginChallengeSeconds": 60
    }
  }
}
