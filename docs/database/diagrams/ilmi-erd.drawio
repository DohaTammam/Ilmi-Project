idden;fontFamily=Consolas;fontSize=11;" vertex="1" parent="t_AspNetUsers"><mxGeometry y="611" width="403" height="21" as="geometry"/></mxCell><mxCell id="t_AspNetUsers_a28" value="[FK]  UpdatedBy : uniqueidentifier   NULL" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontFamily=Consolas;fontSize=11;" vertex="1" parent="t_AspNetUsers"><mxGeometry y="632" width="403" height="21" as="geometry"/></mxCell><mxCell id="t_AspNetUsers_a29" value="  RowVersion : rowversion" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;fontFamily=Consolas;fontSize=11;" vertex="1" parent="t_AspNetUsers"><mxGeometry y="653" width="403" height="21" as="geometry"/></mxCell><mxCell id="t_AspNetUsers_c" value="ASP.NET Core Identity users table (main users table); shared by the Identity user and the Domain user&#xa;UQ (NormalizedEmail): the login identifier; UQ (NormalizedUserName): Identity UserNameIndex&#xa;UQ (MobileCountryCode, MobileNationalNumber, MobileUniquenessKey) WHERE mobile is set: unique across Internal and External users; a Child&#x27;s key is its own Id, so Children may share a number&#xa;UQ (Id, UserKind): target of the composite FKs from the two profile tables&#xa;CHECK UserKind IN (External, Internal); AccountStatus IN (Active, PendingActivation, Deactivated)&#xa;CHECK External =&gt; UserType and mobile NOT NULL; Internal =&gt; UserType NULL&#xa;CHECK PendingActivation =&gt; PendingActivationExpiresAt NOT NULL&#xa;PasswordHash is NULL for social-only users; lockout uses LockoutEnd / AccessFailedCount" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=10;fontColor=#475569;" vertex="1" parent="t_AspNetUsers"><mxGeometry y="674" width="403" height="258" as="geometry"/></mxCell><mxCell id="t_external_users" value="external_users" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;star